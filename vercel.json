{
  "version": 2,
  "installCommand": "npm install && npm --prefix backend install && npm --prefix backend run db:generate",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/[[...path]].ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "backend/prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
