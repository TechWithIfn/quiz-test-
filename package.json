{
  "name": "quizflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc && vite build",
    "build:vercel": "npm run build:backend && npm --prefix backend prune --omit=dev && npm run build",
    "vercel:migrate": "npm --prefix backend run db:deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:backend": "npm --prefix ../backend run dev",
    "build:backend": "npm --prefix ../backend run build",
    "typecheck:backend": "npm --prefix ../backend run typecheck",
    "test:backend": "npm --prefix ../backend run test"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^3.2.0",
    "@prisma/client": "^7.10.0",
    "aws-lambda": "^1.0.7",
    "clsx": "^2.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.29.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
