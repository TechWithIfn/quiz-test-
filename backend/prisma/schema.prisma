// QuizFlow content schema — PostgreSQL.
// Single authoritative source of truth for PUBLIC test content.
// No users, accounts, sessions, or personal data. Online-only platform.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Difficulty {
  beginner
  intermediate
  advanced
}

// Content lifecycle. Only `published` content is served by public APIs.
enum ContentStatus {
  draft
  review
  published
  archived
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  CODE_SNIPPET
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  color       String?

  tests       Test[]
  topics      Topic[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  testTags      TestTag[]
  questionTags  QuestionTag[]
}

model Topic {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  categoryId  String?
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  questions   Question[]

  @@index([categoryId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

model Test {
  id               String        @id @default(cuid())
  // Stable public identifier used in URLs (e.g. "python-basics-test").
  slug             String        @unique
  title            String
  description      String?
  shortDescription String
  difficulty       Difficulty
  // Estimated time to complete, in minutes.
  estimatedTime    Int
  status           ContentStatus @default(draft)
  // Denormalized count, kept in sync with testQuestions rows.
  questionCount    Int           @default(0)

  // SEO / content metadata (backend-owned).
  seoTitle         String?
  seoDescription   String?
  canonicalPath    String?
  indexable        Boolean       @default(true)

  // Discovery / presentation helpers.
  featured         Boolean       @default(false)
  language         String        @default("en")
  passingScorePercentage Int      @default(70)
  // Bumped on every content edit; frontend can cache-bust on change.
  version          String        @default("1.0.0")
  publishedAt      DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category         Category      @relation(fields: [categoryId], references: [id])
  categoryId       String

  testQuestions    TestQuestion[]
  testTags         TestTag[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  // Composite indexes covering the most common public-list predicates.
  @@index([status, featured])
  @@index([status, categoryId])
  @@index([status, difficulty])
}

// ---------------------------------------------------------------------------
// Questions
// ---------------------------------------------------------------------------

model Question {
  id             String        @id @default(cuid())
  question       String
  questionType   QuestionType
  explanation    String
  difficulty     Difficulty
  topic          Topic?        @relation(fields: [topicId], references: [id])
  topicId        String?
  estimatedTime  Int?
  status         ContentStatus @default(draft)
  version        String        @default("1.0.0")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Optional quiz metadata.
  codeSnippet    String?
  codeLanguage   String?
  hint           String?
  concept        String?
  points         Int           @default(1)

  options        Option[]
  testQuestions  TestQuestion[]
  questionTags   QuestionTag[]

  @@index([topicId])
  @@index([status])
  @@index([difficulty])
}

// The correct option is stored via `isCorrect` but is NEVER exposed through
// the public API (see utils/mappers.ts and modules/* handlers).
model Option {
  id           String   @id @default(cuid())
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId   String
  optionText   String
  optionOrder  Int      @default(0)
  isCorrect    Boolean  @default(false)
  codeSnippet  String?

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Relations (many-to-many junctions)
// ---------------------------------------------------------------------------

// A question may belong to multiple tests.
model TestQuestion {
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId        String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId    String
  questionOrder Int      @default(0)

  @@id([testId, questionId])
  @@index([questionId])
}

model TestTag {
  test      Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId    String
  tag       Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([testId, tagId])
  @@index([tagId])
}

model QuestionTag {
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([questionId, tagId])
  @@index([tagId])
}
