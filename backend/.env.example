# QuizFlow backend environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored — secrets never
# get committed. NEVER set CORS_ORIGINS to "*" in production.

NODE_ENV=development

# HTTP server
PORT=3001
API_BASE_URL=http://localhost:3001

# Set to "true" ONLY when deployed behind a trusted reverse proxy / load balancer.
# Required so per-client-IP rate limiting uses the real visitor IP (from
# X-Forwarded-For) instead of the proxy's IP. Leaving it "false" is the safe
# default and prevents IP spoofing.
TRUST_PROXY=false

# PostgreSQL connection string (NEVER commit a real value).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/quizflow?schema=public

# Comma-separated list of allowed frontend origins. In production set this to
# your real site origin(s), e.g. https://quizflow.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Content version reported by /api/content/governance.
CONTENT_VERSION=1.0.0

# When "true", full error details (stack traces) are returned. Keep "false" in
# production so internals (SQL, paths, env) are never leaked to clients.
EXPOSE_ERROR_DETAILS=false

# Rate limiting (requests per client IP per window). Normal users are nowhere
# near these ceilings; they exist to blunt scraping and abuse.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SUBMIT_MAX=30
RATE_LIMIT_QUESTIONS_MAX=120
